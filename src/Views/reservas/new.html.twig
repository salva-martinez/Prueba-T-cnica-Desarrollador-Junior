
{% extends "base.html.twig" %}

{% block title %}Nueva reserva{% endblock %}

{% block content %}
    <div class="formulario-pagina">
        <h1>Crear nueva reserva</h1>

        <p class="formulario-intro">
            Introduce los datos para registrar una nueva reserva.
        </p>

        <form id="formNuevaReserva" class="formulario-reserva" novalidate>
            <div class="campo-formulario">
                <label for="nombre_huesped">Nombre del huésped:</label>
                <input
                    type="text"
                    id="nombre_huesped"
                    name="nombre_huesped"
                    required
                    autocomplete="name"
                >
                <small class="error" id="error_nombre_huesped"></small>
            </div>

            <div class="campo-formulario">
                <label for="email_huesped">Correo electrónico:</label>
                <input
                    type="email"
                    id="email_huesped"
                    name="email_huesped"
                    required
                    autocomplete="email"
                >
                <small class="error" id="error_email_huesped"></small>
            </div>

            <div class="campo-formulario">
                <label for="nombre_alojamiento">Nombre del alojamiento:</label>
                <input
                    type="text"
                    id="nombre_alojamiento"
                    name="nombre_alojamiento"
                    required
                >
                <small class="error" id="error_nombre_alojamiento"></small>
            </div>

            <div class="campo-formulario">
                <label for="fecha_entrada">Fecha de entrada:</label>
                <input
                    type="date"
                    id="fecha_entrada"
                    name="fecha_entrada"
                    required
                >
                <small class="error" id="error_fecha_entrada"></small>
            </div>

            <div class="campo-formulario">
                <label for="fecha_salida">Fecha de salida:</label>
                <input
                    type="date"
                    id="fecha_salida"
                    name="fecha_salida"
                    required
                >
                <small class="error" id="error_fecha_salida"></small>
            </div>

            <div class="campo-formulario">
                <label for="importe">Importe (€):</label>
                <input
                    type="number"
                    id="importe"
                    name="importe"
                    min="0"
                    step="0.01"
                    required
                >
                <small class="error" id="error_importe"></small>
            </div>

            <div class="campo-formulario campo-completo">
                <label for="notas">Notas (opcional):</label>
                <textarea
                    id="notas"
                    name="notas"
                    rows="4"
                    placeholder="Máximo 500 caracteres"
                ></textarea>
                <small class="error" id="error_notas"></small>
            </div>

            <div class="formulario-acciones campo-completo">
                <button type="submit" class="btn-guardar">
                    Guardar reserva
                </button>

                <a href="/" class="btn-volver">
                    Volver al listado
                </a>
            </div>

            <p
                id="mensajeFormulario"
                class="mensaje-formulario campo-completo"
                role="status"
                aria-live="polite"
            ></p>
        </form>
    </div>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script src="/js/nuevaReserva.js" defer></script>
{% endblock %}

{% extends "base.html.twig" %}

{% block title %}Nueva reserva{% endblock %}

{% block content %}
    <h1>Crear nueva reserva</h1>

    <p>Introduce los datos de la reserva.</p>

    <form id="formNuevaReserva" novalidate>
        <div>
            <label for="nombre_huesped">Nombre del huésped:</label>
            <input
                type="text"
                id="nombre_huesped"
                name="nombre_huesped"
                required
            >
            <small class="error" id="error_nombre_huesped"></small>
        </div>

        <div>
            <label for="email_huesped">Correo electrónico:</label>
            <input
                type="email"
                id="email_huesped"
                name="email_huesped"
                required
            >
            <small class="error" id="error_email_huesped"></small>
        </div>

        <div>
            <label for="nombre_alojamiento">Nombre del alojamiento:</label>
            <input
                type="text"
                id="nombre_alojamiento"
                name="nombre_alojamiento"
                required
            >
            <small class="error" id="error_nombre_alojamiento"></small>
        </div>

        <div>
            <label for="fecha_entrada">Fecha de entrada:</label>
            <input
                type="date"
                id="fecha_entrada"
                name="fecha_entrada"
                required
            >
            <small class="error" id="error_fecha_entrada"></small>
        </div>

        <div>
            <label for="fecha_salida">Fecha de salida:</label>
            <input
                type="date"
                id="fecha_salida"
                name="fecha_salida"
                required
            >
            <small class="error" id="error_fecha_salida"></small>
        </div>

        <div>
            <label for="importe">Importe (€):</label>
            <input
                type="number"
                id="importe"
                name="importe"
                min="0"
                step="0.01"
                required
            >
            <small class="error" id="error_importe"></small>
        </div>

        <div>
            <label for="notas">Notas:</label>
            <textarea
                id="notas"
                name="notas"
            ></textarea>
            <small class="error" id="error_notas"></small>
        </div>

        <p id="mensajeFormulario" role="status" aria-live="polite"></p>

        <button type="submit">Guardar reserva</button>

        <a href="/public/index.php">Volver al listado</a>
    </form>
{% endblock %}

{% block scripts %}
    {{ parent() }}
    <script src="/js/nuevaReserva.js" defer></script>
{% endblock %}

{% extends "base.html.twig" %}

{% block title %}Detalle de la Reserva id: {{ reserva.id }}{% endblock %}

{% block content %}
    <h2>Detalle de la Reserva {{ reserva.id }}</h2>

    <p><strong>ID:</strong> {{ reserva.id }}</p>
    <p><strong>Huésped:</strong> {{ reserva.nombreHuesped }}</p>
    <p><strong>Alojamiento:</strong> {{ reserva.nombreAlojamiento }}</p>
    <p><strong>Fecha de Entrada:</strong> {{ reserva.fechaEntrada }}</p>
    <p><strong>Fecha de Salida:</strong> {{ reserva.fechaSalida }}</p>
    <p><strong>Estado:</strong> {{ reserva.estado }}</p>
    <p><strong>Importe:</strong> {{ reserva.importe }} €</p>

    <h3>Historial de eventos</h3>

    <div class="historial-eventos">
        {% for evento in eventos %}
            <div class="evento">
                <div class="evento-cabecera">
                    <span class="evento-tipo evento-{{ evento.tipo|lower }}">
                        {{ evento.tipo|capitalize }}
                    </span>

                    {% if loop.last %}
                        <span class="evento-actual">
                            Estado actual
                        </span>
                    {% endif %}
                </div>

                <p class="evento-descripcion">
                    {{ evento.descripcion ?? 'Evento sin descripción' }}
                </p>

                <p class="evento-fecha">
                    <span>Fecha:</span>
                    {{ evento.fecha }}
                </p>
            </div>
        {% else %}
            <p>No hay eventos registrados para esta reserva.</p>
        {% endfor %}
    </div>

    <p id="mensajeCancelacion" role="status" aria-live="polite"></p>

    <p><a href="/">← Volver al listado</a></p>
{% endblock %}

{% block scripts %}
    <script src="/js/cancelarReserva.js" defer></script>
{% endblock %}
{% extends "base.html.twig" %}

{% block title %}Detalle de la Reserva id: {{ reserva.id }}{% endblock %}

{% block content %}
    
    <h2>Detalle de la reserva #{{ reserva.id }}</h2>

    <div class="detalle-reserva">
        <p>
            <strong>ID:</strong>
            {{ reserva.id }}
        </p>

        <p>
            <strong>Huésped:</strong>
            {{ reserva.nombreHuesped }}
        </p>

        {% if reserva.notas %}
            <p>
                <strong>Notas:</strong>
                {{ reserva.notas }}
            </p>
        {% endif %}

        <p>
            <strong>Alojamiento:</strong>
            {{ reserva.nombreAlojamiento }}
        </p>

        <p>
            <strong>Fecha de entrada:</strong>
            {{ reserva.fechaEntrada }}
        </p>

        <p>
            <strong>Fecha de salida:</strong>
            {{ reserva.fechaSalida }}
        </p>

        <p>
            <strong>Estado:</strong>
            <span id="estadoReserva" class="estado-detalle estado-detalle-{{ reserva.estado|lower }}">
                {{ reserva.estado|capitalize }}
            </span>
        </p>

        <p>
            <strong>Importe:</strong>
            {{ reserva.importe }} €
        </p>
    </div>


    <h3>Historial de eventos</h3>

        <div class="historial-eventos">
            {% for evento in eventos %}
                <div class="evento">
                    <div class="evento-cabecera">
                        <span class="evento-tipo evento-{{ evento.tipo|lower }}">
                            {{ evento.tipo|capitalize }}
                        </span>

                        {% if loop.last %}
                            <span class="evento-actual">
                                Estado actual
                            </span>
                        {% endif %}
                    </div>

                    <p class="evento-descripcion">
                        {{ evento.descripcion ?? 'Evento sin descripción' }}
                    </p>

                    <p class="evento-fecha">
                        <span>Fecha:</span>
                        {{ evento.fecha }}
                    </p>
                </div>
            {% else %}
                <p>No hay eventos registrados para esta reserva.</p>
            {% endfor %}
        </div>

    {% if reserva.estado == 'pendiente' %}
        <button
            type="button"
            id="btnConfirmarReserva"
            data-id="{{ reserva.id }}"
            class="btn-confirmar"
        >
            Confirmar reserva
        </button>
    {% elseif reserva.estado == 'confirmada' %}
        <p>Esta reserva ya está confirmada.</p>
    {% endif %}

    {% if reserva.estado != 'cancelada' %}
        <button
            type="button"
            id="btnCancelarReserva"
            data-id="{{ reserva.id }}"
            class="btn-cancelar"
        >
            Cancelar reserva
        </button>
    {% else %}
        <p>Esta reserva ya está cancelada.</p>
    {% endif %}

    <p id="mensajeConfirmacion" role="status" aria-live="polite"></p>
    <p id="mensajeCancelacion" role="status" aria-live="polite"></p>

    <p>
        <a href="/" class="btn-volver">Volver al listado</a>
    </p>
{% endblock %}

{% block scripts %}
    <script src="/js/confirmarReserva.js" defer></script>
    <script src="/js/cancelarReserva.js" defer></script>
{% endblock %}